# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/alifx

# Redis
REDIS_URL=redis://localhost:6379/0

# NewsAPI
NEWSAPI_KEY=your_newsapi_key_here

# OpenAI (optional - for LLM event enrichment)
OPENAI_API_KEY=your_openai_key_here

# Alpha Vantage (fallback for stocks if Yahoo Finance rate-limits)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# FX API (frankfurter.app is free, no key needed)
FX_API_BASE_URL=https://api.frankfurter.app

# Polling intervals (seconds)
MARKET_DATA_POLL_INTERVAL=120
NEWS_POLL_INTERVAL=300
PIPELINE_RUN_INTERVAL=300

# App
APP_ENV=development
LOG_LEVEL=INFO
