# Database — PostgreSQL in production (Render/Railway provide this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/aliufx

# News data
NEWSAPI_KEY=your_newsapi_key_here

# LLM providers (at least one required for AI copilot)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# LLM provider selection: auto | anthropic | openai
LLM_PROVIDER=auto

# App
APP_ENV=development
LOG_LEVEL=INFO

# Polling intervals (seconds)
MARKET_DATA_POLL_INTERVAL=120
NEWS_POLL_INTERVAL=300
PIPELINE_RUN_INTERVAL=300
